---
import "@/styles/starwind.css";
import { ClientRouter } from "astro:transitions";
import { ThemeInitScript } from "@starwind-ui/astro/theme";
import * as m from "@/paraglide/messages.js";
import SEO from "@components/SEO.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import TimerTray from "@components/TimerTray.astro";
import IdleScreen from "@components/IdleScreen.astro";
import { DEFAULT_LOCALE } from "@/lib/locale";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  publishedDate?: string;
}

const { title, description, ogImage, canonicalUrl, type, publishedDate } = Astro.props;
const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Private family site behind Cloudflare Access — keep it out of search engines. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fbf6ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#231c18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Installable app (iPad: Share → Add to Home Screen). use-credentials: the
         manifest fetch must carry the Cloudflare Access cookie or Access blocks it. -->
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={m.site_name()} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preload" href="/fonts/Nunito-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <ThemeInitScript defaultTheme="system" />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={canonicalUrl}
      type={type}
      publishedDate={publishedDate}
    />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased print:bg-white print:text-black">
    <a
      href="#main"
      class="sr-only z-70 rounded-xl bg-primary px-4 py-3 font-semibold text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {m.skip_to_content()}
    </a>
    <Header />
    <p
      data-offline-notice
      role="status"
      style="display: none"
      class="sticky top-[4.25rem] z-20 bg-warning px-4 py-2 text-center text-base font-semibold text-warning-foreground print:hidden"
    >
      {m.offline_notice()}
    </p>
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
    <TimerTray />
    <IdleScreen />
    <script>
      import "@/scripts/pwa";
      // Loaded on every page: Android's install event fires once, on the first page load.
      import "@/scripts/install";
      import "@/scripts/back";
      import "@/scripts/offline";
    </script>
  </body>
</html>
