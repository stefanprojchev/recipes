---
import Layout from "@layouts/Layout.astro";
import ContactForm from "@components/ContactForm.astro";
import * as m from "@/paraglide/messages.js";
---

<Layout title={m.contact_title()} description={m.contact_description()}>
  <section class="mx-auto max-w-5xl px-6 py-24">
    <h1 class="text-3xl font-bold font-heading tracking-tight">
      {m.contact_title()}
    </h1>
    <div class="mt-8">
      <ContactForm />
    </div>
  </section>
</Layout>
