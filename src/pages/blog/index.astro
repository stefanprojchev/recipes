---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import * as m from "@/paraglide/messages.js";
import { DEFAULT_LOCALE } from "@/lib/locale";

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;

const posts = (await getCollection("blog", (entry) => {
  return entry.id.startsWith(`${locale}/`) && !entry.data.draft;
})).sort((a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
---

<Layout title={m.blog_title()} description={m.blog_description()}>
  <section class="mx-auto max-w-5xl px-6 py-24">
    <h1 class="text-3xl font-bold font-heading tracking-tight">
      {m.blog_title()}
    </h1>

    <div class="mt-12 flex flex-col gap-8">
      {posts.length === 0 && (
        <p class="text-muted-foreground">{m.blog_no_posts()}</p>
      )}

      {posts.map((post) => {
        const slug = post.id.replace(`${locale}/`, "");
        return (
          <article class="group">
            <a href={getRelativeLocaleUrl(locale, `/blog/${slug}`)} class="block">
              <time
                datetime={post.data.publishedDate.toISOString()}
                class="text-sm text-muted-foreground"
              >
                {post.data.publishedDate.toLocaleDateString(locale, {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <h2 class="mt-1 text-xl font-semibold group-hover:underline">
                {post.data.title}
              </h2>
              <p class="mt-1 text-muted-foreground">
                {post.data.description}
              </p>
            </a>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
