---
import ArrowLeft from "@tabler/icons/outline/arrow-left.svg";
import Check from "@tabler/icons/outline/check.svg";
import ChefHat from "@tabler/icons/outline/chef-hat.svg";
import Printer from "@tabler/icons/outline/printer.svg";
import Minus from "@tabler/icons/outline/minus.svg";
import Plus from "@tabler/icons/outline/plus.svg";
import CalendarTime from "@tabler/icons/outline/calendar-time.svg";
import * as m from "@/paraglide/messages.js";
import { localizeHref } from "@/paraglide/runtime.js";
import Layout from "@layouts/Layout.astro";
import MediaItem from "@components/media/MediaItem.astro";
import CategoryIcon from "@components/recipe/CategoryIcon.astro";
import CookMode from "@components/recipe/CookMode.astro";
import IngredientList from "@components/recipe/IngredientList.astro";
import HouseholdWarnings from "@components/plan/HouseholdWarnings.astro";
import RecipeCard from "@components/recipe/RecipeCard.astro";
import RecipeImage from "@components/recipe/RecipeImage.astro";
import RecipePrintSheet from "@components/recipe/RecipePrintSheet.astro";
import StepTimerButton from "@components/recipe/StepTimerButton.astro";
import VariantNotes from "@components/recipe/VariantNotes.astro";
import { asLocale, t } from "@/lib/i18n-content";
import {
  categoryLabel,
  dietLabel,
  difficultyLabel,
  formatDuration,
  mealLabel,
  tagLabel,
} from "@/lib/labels";
import { getIngredients, getRecipes, totalMinutes, type Recipe } from "@/lib/recipes";

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
const locale = asLocale(Astro.currentLocale);
const ingredients = await getIngredients();
const allRecipes = await getRecipes();

const { data } = recipe;
const title = t(data.title, locale);
const parent = data.variantOf ? allRecipes.find((r) => r.id === data.variantOf?.id) : undefined;
const siblings = allRecipes.filter(
  (r) => r.id !== recipe.id && r.data.variantOf && r.data.variantOf.id === (data.variantOf?.id ?? recipe.id),
);
const related = [...(parent ? [parent] : []), ...siblings];

const times = [
  { label: m.recipe_time_prep(), minutes: data.time.prep },
  { label: m.recipe_time_cook(), minutes: data.time.cook },
  { label: m.recipe_time_rest(), minutes: data.time.rest },
].filter((entry) => entry.minutes > 0);

const extras = [
  { label: m.recipe_tips(), text: data.tips },
  { label: m.recipe_story(), text: data.story },
  { label: m.recipe_storage(), text: data.storage },
].filter((entry) => entry.text !== undefined);
---

<Layout title={`${title} · ${m.site_name()}`} description={t(data.summary, locale)}>
  <article
    id="recipe"
    data-base-servings={data.servings}
    data-variant="base"
    class="mx-auto max-w-6xl px-4 pt-4 pb-24 sm:px-6"
  >
    <!--
      Landscape tablet (lg+): two panes side by side, each scrolling on its own —
      left: what you need (title, times, variants, ingredients), right: what you do (steps).
      Both are on screen from the first glance. Narrower screens stack them.
    -->
    <RecipePrintSheet recipe={recipe} ingredients={ingredients} locale={locale} />

    <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12 print:hidden">
      <div class="lg:sticky lg:top-[4.75rem] lg:max-h-[calc(100dvh-5.5rem)] lg:self-start lg:overflow-y-auto lg:overscroll-contain lg:pr-3 lg:pb-6 lg:[scrollbar-width:thin]">
        <a
          href={localizeHref("/recipes")}
          data-back
          class="inline-flex h-11 items-center gap-2 rounded-full pr-3 text-base font-semibold text-muted-foreground hover:text-foreground"
        >
          <ArrowLeft class="size-5" aria-hidden="true" />{m.recipe_back()}
        </a>

        <header class="mt-2">
          {data.cover && <RecipeImage recipe={recipe} locale={locale} size="hero" class="mb-5 rounded-3xl lg:aspect-[16/10]" />}
          <a
            href={`${localizeHref("/recipes")}?c=${data.category}`}
            class="inline-flex h-11 items-center gap-2 rounded-full bg-secondary px-4 text-base font-semibold text-secondary-foreground hover:bg-accent"
          >
            <CategoryIcon category={data.category} class="size-4" />{categoryLabel(data.category, locale)}
          </a>
          <h1 class="mt-3 font-heading text-4xl leading-tight font-semibold text-balance sm:text-5xl lg:text-4xl">{title}</h1>
          <p class="mt-2 text-xl text-muted-foreground lg:text-lg">{t(data.summary, locale)}</p>

          <dl
            class:list={[
              "mt-5 grid gap-3 lg:gap-2",
              // Total + prep/cook/rest: 2–4 tiles. Three fit one row even on phones — no orphan tile.
              // In the landscape pane they shrink to one compact row to keep the ingredients high.
              times.length + 1 === 4 ? "grid-cols-2 sm:grid-cols-4" : times.length + 1 === 3 ? "grid-cols-3" : "grid-cols-2",
            ]}
          >
            <div class="rounded-2xl bg-muted p-3 lg:px-2.5 lg:py-2">
              <dt class="text-sm text-muted-foreground">{m.recipe_time_total()}</dt>
              <dd class="text-lg font-bold lg:text-base">{formatDuration(totalMinutes(recipe), locale)}</dd>
            </div>
            {times.map((entry) => (
              <div class="rounded-2xl bg-muted p-3 lg:px-2.5 lg:py-2">
                <dt class="text-sm text-muted-foreground">{entry.label}</dt>
                <dd class="text-lg font-bold lg:text-base">{formatDuration(entry.minutes, locale)}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
            <span class="rounded-full bg-muted px-3 py-1 font-semibold">{m.recipe_difficulty()}: {difficultyLabel(data.difficulty, locale)}</span>
            <span class="ml-1 text-muted-foreground">{m.recipe_good_for()}:</span>
            {data.meals.map((meal) => (
              <span class="rounded-full border border-border px-3 py-1 font-semibold">{mealLabel(meal, locale)}</span>
            ))}
            {data.diet.map((diet) => (
              <span class="rounded-full bg-success px-3 py-1 font-semibold text-success-foreground">{dietLabel(diet, locale)}</span>
            ))}
            {data.tags.map((tag) => (
              <span class="rounded-full border border-primary/40 bg-primary/10 px-3 py-1 font-semibold text-primary">{tagLabel(tag, locale)}</span>
            ))}
          </div>
          <HouseholdWarnings recipe={recipe} locale={locale} class="mt-3" />

          {data.from && <p class="mt-4 text-base text-muted-foreground italic">{m.recipe_from({ name: data.from })}</p>}

          <div class="mt-5 flex flex-wrap gap-3">
            <button
              type="button"
              data-cook-open
              class="inline-flex h-16 flex-1 items-center justify-center gap-3 rounded-2xl bg-primary px-8 text-xl font-semibold whitespace-nowrap text-primary-foreground shadow-sm hover:bg-primary-accent sm:flex-none lg:flex-1"
            >
              <ChefHat class="size-7" aria-hidden="true" />{m.recipe_cook_mode()}
            </button>
            <button
              type="button"
              data-print
              class="inline-flex h-16 items-center justify-center gap-2 rounded-2xl bg-secondary px-6 text-lg font-semibold text-secondary-foreground hover:bg-accent"
            >
              <Printer class="size-6" aria-hidden="true" />{m.print_button()}
            </button>
          </div>
        </header>

        {
          data.variants.length > 0 && (
            <section class="mt-8" aria-labelledby="variants-heading">
              <h2 id="variants-heading" class="mb-3 text-sm font-bold tracking-wide text-muted-foreground uppercase">
                {m.recipe_variants()}
              </h2>
              <div class="flex flex-wrap gap-2" role="group" aria-labelledby="variants-heading">
                <button
                  type="button"
                  data-variant-option="base"
                  aria-pressed="true"
                  class="h-12 rounded-full border border-input px-5 text-lg font-semibold transition-colors aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
                >
                  {m.recipe_variant_base()}
                </button>
                {data.variants.map((variant) => (
                  <button
                    type="button"
                    data-variant-option={variant.id}
                    aria-pressed="false"
                    class="h-12 rounded-full border border-input px-5 text-lg font-semibold transition-colors aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground"
                  >
                    {t(variant.name, locale)}
                  </button>
                ))}
              </div>
            </section>
          )
        }

        <section aria-labelledby="ingredients-heading" class="mt-8">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 id="ingredients-heading" class="font-heading text-3xl font-semibold">{m.recipe_ingredients()}</h2>
            <div class="flex items-center gap-1 rounded-full bg-muted p-1" role="group" aria-label={m.recipe_servings()}>
              <button
                type="button"
                data-servings-step="-1"
                class="inline-flex size-11 items-center justify-center rounded-full bg-card shadow-xs hover:bg-accent disabled:opacity-40"
                aria-label={m.recipe_servings_less()}
              >
                <Minus class="size-5" aria-hidden="true" />
              </button>
              <span class="min-w-24 text-center text-base font-semibold" aria-live="polite">
                <span data-servings-value class="text-xl tabular-nums">{data.servings}</span>{" "}
                {m.recipe_servings_unit()}
              </span>
              <button
                type="button"
                data-servings-step="1"
                class="inline-flex size-11 items-center justify-center rounded-full bg-card shadow-xs hover:bg-accent disabled:opacity-40"
                aria-label={m.recipe_servings_more()}
              >
                <Plus class="size-5" aria-hidden="true" />
              </button>
            </div>
          </div>
          <div class="mt-4">
            <IngredientList recipe={recipe} ingredients={ingredients} locale={locale} idPrefix="main" />
          </div>
        </section>
      </div>

      <div class="lg:pt-[3.25rem]">
        {
          data.prepAhead && (
            <div class="mb-8 flex gap-3 rounded-2xl border border-warning bg-warning/25 p-4 text-lg">
              <CalendarTime class="mt-0.5 size-6 shrink-0" aria-hidden="true" />
              <p>
                <strong class="font-semibold">{m.recipe_prep_ahead()}:</strong>{" "}{t(data.prepAhead, locale)}
              </p>
            </div>
          )
        }

        <section aria-labelledby="steps-heading">
          <h2 id="steps-heading" class="font-heading text-3xl font-semibold">{m.recipe_steps()}</h2>
          <VariantNotes recipe={recipe} locale={locale} class="mt-4" />
          <ol class="mt-4 flex flex-col gap-6">
            {data.steps.map((step, i) => (
              <li class="group/step flex gap-4" data-step>
                <button
                  type="button"
                  data-step-toggle
                  aria-pressed="false"
                  aria-label={m.recipe_step_done({ n: i + 1 })}
                  class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary text-lg font-bold text-primary-foreground transition-colors aria-pressed:bg-success aria-pressed:text-success-foreground"
                >
                  <span class="group-data-done/step:hidden">{i + 1}</span>
                  <Check class="hidden size-6 group-data-done/step:block" aria-hidden="true" />
                </button>
                <div class="flex-1 pt-2 transition-opacity group-data-done/step:opacity-50">
                  <p class="max-w-[65ch] text-xl leading-relaxed">{t(step.text, locale)}</p>
                  {step.media && (
                    <MediaItem
                      id={step.media.id}
                      locale={locale}
                      alt={`${title} · ${m.recipe_step_n({ n: i + 1 })}`}
                      layout="half"
                      class="mt-3 w-full max-w-xl rounded-2xl"
                    />
                  )}
                  {step.timer && (
                    <StepTimerButton
                      minutes={step.timer}
                      label={`${title} · ${m.recipe_step_n({ n: i + 1 })}`}
                      locale={locale}
                      class="mt-3"
                    />
                  )}
                </div>
              </li>
            ))}
          </ol>

          {data.gallery.length > 0 && (
            <section class="mt-10">
              <h3 class="font-heading text-2xl font-semibold">{m.recipe_gallery()}</h3>
              <div class="mt-4 grid grid-cols-2 gap-3">
                {data.gallery.map((ref) => (
                  <MediaItem id={ref.id} locale={locale} alt={title} layout="grid" class="aspect-4/3 w-full rounded-2xl" />
                ))}
              </div>
            </section>
          )}

          {extras.map((entry) => (
            <section class="mt-10">
              <h3 class="font-heading text-2xl font-semibold">{entry.label}</h3>
              <p class="mt-2 text-lg leading-relaxed whitespace-pre-line text-muted-foreground">
                {entry.text && t(entry.text, locale)}
              </p>
            </section>
          ))}
        </section>
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-16 print:hidden" aria-labelledby="related-heading">
          <h2 id="related-heading" class="font-heading text-2xl font-semibold">
            {parent ? m.recipe_variant_of() : m.recipe_related_variants()}
          </h2>
          <div class="mt-4 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
            {related.map((r) => (
              <RecipeCard recipe={r} locale={locale} />
            ))}
          </div>
        </section>
      )
    }

    <CookMode recipe={recipe} ingredients={ingredients} locale={locale} />
  </article>
</Layout>

<script>
  import "@/scripts/recipe";
  import "@/scripts/print";
</script>
