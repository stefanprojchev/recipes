---
/**
 * Idle kitchen screen — shown by src/scripts/idle.ts after a few minutes
 * without a touch: big clock plus today's (or, in the evening, tomorrow's)
 * menu; a dim clock at night. Persisted across navigations per locale.
 */
import * as m from "@/paraglide/messages.js";
import { localizeHref } from "@/paraglide/runtime.js";
import LogoMark from "@components/LogoMark.astro";
import { DEFAULT_LOCALE } from "@/lib/locale";

const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
---

<div
  id="idle-screen"
  transition:persist={`idle-screen-${locale}`}
  role="dialog"
  aria-modal="true"
  tabindex="-1"
  aria-label={m.idle_label()}
  style="display: none"
  data-src={localizeHref("/idle.json")}
  data-label-today={m.today_title()}
  data-label-tomorrow={m.idle_tomorrow()}
  data-label-prep={m.day_prep_tomorrow()}
  data-label-open={m.today_open_sheet()}
  data-label-none={m.today_none()}
  data-label-next={m.idle_next({ title: "{title}" })}
  data-label-all-done={m.idle_all_done()}
  class="group/idle print:hidden fixed inset-0 z-55 cursor-pointer overflow-hidden overscroll-none outline-none bg-background text-foreground select-none data-night:bg-black data-night:text-neutral-500"
>
  <div
    data-idle-content
    class="flex h-dvh w-full flex-col justify-center gap-10 px-10 py-12 transition-transform duration-[3000ms] ease-in-out lg:flex-row lg:items-center lg:gap-16 lg:px-16 group-data-night/idle:items-center group-data-night/idle:justify-center"
  >
    <div class="shrink-0 lg:w-[45%] group-data-night/idle:w-auto group-data-night/idle:text-center">
      <LogoMark class="mb-6 size-14 text-primary group-data-night/idle:hidden" />
      <p data-idle-clock class="font-heading text-[clamp(6rem,15vw,12rem)] leading-none font-semibold tabular-nums group-data-night/idle:text-[clamp(4rem,10vw,7rem)] group-data-night/idle:font-normal"></p>
      <p data-idle-date class="mt-4 text-3xl text-muted-foreground first-letter:uppercase group-data-night/idle:hidden"></p>
    </div>
    <div data-idle-panel class="min-w-0 flex-1 group-data-night/idle:hidden"></div>
  </div>
  <p class="absolute inset-x-0 bottom-6 text-center text-base text-muted-foreground pb-[env(safe-area-inset-bottom)] group-data-night/idle:hidden">
    {m.idle_tap()}
  </p>
</div>

<script>
  import "@/scripts/idle";
</script>
