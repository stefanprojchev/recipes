---
import * as m from "@/paraglide/messages.js";
import { localizeHref } from "@/paraglide/runtime.js";
import LanguagePicker from "@components/LanguagePicker.astro";

const navItems = [
  { label: m.nav_home(), href: localizeHref("/") },
  { label: m.nav_blog(), href: localizeHref("/blog") },
  { label: m.nav_contact(), href: localizeHref("/contact") },
];
---

<header class="border-b border-border">
  <div class="mx-auto max-w-5xl flex items-center justify-between px-6 py-4">
    <a href={localizeHref("/")} class="text-lg font-semibold font-heading">
      {m.site_name()}
    </a>

    <nav class="flex items-center gap-6">
      {navItems.map(({ label, href }) => (
        <a
          href={href}
          class="text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
          {label}
        </a>
      ))}
      <LanguagePicker />
    </nav>
  </div>
</header>
