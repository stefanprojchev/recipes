---
import Clock from "@tabler/icons/outline/clock.svg";
import { localizeHref } from "@/paraglide/runtime.js";
import RecipeImage from "@components/recipe/RecipeImage.astro";
import { t } from "@/lib/i18n-content";
import { dietLabel, difficultyLabel, formatDuration, tagLabel } from "@/lib/labels";
import type { Locale } from "@/lib/locale";
import { totalMinutes, type Recipe } from "@/lib/recipes";

interface Props {
  recipe: Recipe;
  locale: Locale;
  /** Normalized search text — set on catalogue cards so the filter can match. */
  search?: string;
  class?: string;
}

const { recipe, locale, search, class: className } = Astro.props;
const { title, summary, category, diet, meals, difficulty, tags } = recipe.data;
const minutes = totalMinutes(recipe);
/** Diet flags worth a badge on a card; vegetarian is implied by vegan. */
const badges = diet.filter((d) => d === "fasting" || (d === "vegetarian" && !diet.includes("vegan")) || d === "vegan");
---

<a
  href={localizeHref(`/recipes/${recipe.id}`)}
  class:list={[
    "group flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-xs transition hover:-translate-y-0.5 hover:shadow-md focus-visible:ring-3 focus-visible:ring-outline/50 focus-visible:outline-none",
    className,
  ]}
  data-recipe-card
  data-search={search}
  data-category={category}
  data-meals={meals.join(" ")}
  data-diet={diet.join(" ")}
  data-tags={tags.join(" ")}
  data-minutes={minutes}
>
  <RecipeImage recipe={recipe} locale={locale} size="card" />
  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="font-heading text-xl leading-snug font-semibold text-card-foreground">{t(title, locale)}</h3>
    <p class="line-clamp-2 text-sm text-muted-foreground">{t(summary, locale)}</p>
    <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 text-sm text-muted-foreground">
      <span class="inline-flex items-center gap-1"><Clock class="size-4" aria-hidden="true" />{formatDuration(minutes, locale)}</span>
      <span>{difficultyLabel(difficulty, locale)}</span>
      {badges.map((d) => (
        <span class="rounded-full bg-success px-2 py-0.5 text-sm font-semibold text-success-foreground">{dietLabel(d, locale)}</span>
      ))}
      {tags.map((tag) => (
        <span class="rounded-full border border-primary/40 bg-primary/10 px-2 py-0.5 text-sm font-semibold text-primary">{tagLabel(tag, locale)}</span>
      ))}
    </div>
  </div>
</a>
