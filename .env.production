# Production build-time vars — COMMITTED so Workers Builds needs zero
# dashboard build variables. Only PUBLIC_* values belong here (they are
# public by definition — inlined into the shipped HTML/JS). Never add secrets.
#
# The go-live flow replaces both values. The test site key below always
# passes the visible widget but real-secret verification rejects its tokens,
# so an unconfigured deploy fails loudly at the go-live contact-form check.

PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_SITE_URL=https://example.com
