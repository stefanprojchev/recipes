# Local development build-time vars. Copy to .env (gitignored).
#
# Only PUBLIC_*-prefixed vars belong here — they are inlined by `astro build`
# / `astro dev`. Runtime Worker vars live in wrangler.toml [vars]; runtime
# secrets for local `wrangler dev` go in .dev.vars (see .dev.vars.example).
#
# The default below is Cloudflare's always-passing visible test widget, so a
# fresh clone builds and renders out of the box. Real keys are provisioned at
# go-live (cloudflare:turnstile-spin skill) into the committed .env.production.

PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
PUBLIC_SITE_URL=https://example.com
